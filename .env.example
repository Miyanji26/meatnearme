# Postgres on Render supplies this automatically; falls back to local SQLite when unset.
DATABASE_URL=postgresql://user:pass@localhost:5432/freshcut

# Signs the ops session cookie.
SECRET_KEY=change-me

# Gate for /ops.
OPS_PASSWORD=change-me

# Required in the X-Agent-Key header on every /tools/* call.
AGENT_API_KEY=change-me

# Pine Labs (Plural). UAT: https://pluraluat.v2.pinepg.in  Prod: https://api.pluralpay.in
PINELABS_BASE_URL=https://pluraluat.v2.pinepg.in

# Authenticate with EITHER an API key (used as the bearer token as-is) OR a
# client id/secret pair (exchanged for a short-lived token). The key wins if
# both are filled in. Leave all three blank to run with payments switched off.
PINELABS_API_KEY=
PINELABS_CLIENT_ID=
PINELABS_CLIENT_SECRET=

# Used to build payment callback and tracking URLs. Leave unset on Render: the app
# falls back to RENDER_EXTERNAL_URL. Set it only for a custom domain.
PUBLIC_BASE_URL=http://localhost:8000

# Load the three demo Shivajinagar shops at startup. Leave off once the real
# catalogue is in - the seed rewrites prices for the shops it owns.
SEED_ON_START=false

# Ops flags an order when the final price drifts this far from the estimate.
PRICE_GAP_THRESHOLD=0.10
